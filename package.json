{
  "name": "agentic-web-testing",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic framework for web application testing and fault diagnosis",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "agent": "tsx src/cli.ts agent",
    "eval": "tsx src/cli.ts eval",
    "llm:ping": "tsx src/llm/ping.ts",
    "target:up": "tsx src/modules/execution-engine/target-up.ts",
    "target:facts": "tsx src/modules/execution-engine/target-facts.ts"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "openai": "^7.39.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
