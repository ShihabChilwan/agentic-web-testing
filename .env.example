# Copy to .env and fill in. Never commit .env.

# Model provider: openai-compatible (self-hosted vLLM, OpenAI) or anthropic
LLM_PROVIDER=openai-compatible

# Endpoint address (ending in /v1) and the model name the server exposes
LLM_BASE_URL=
LLM_MODEL=openai/gpt-oss-120b

# API key, if the endpoint requires one
LLM_API_KEY=

# Extra HTTP headers as JSON, if the endpoint requires them (e.g. proxy authentication)
LLM_EXTRA_HEADERS=

# Sampling (recommended for gpt-oss: 1.0 and 1.0)
LLM_TEMPERATURE=1.0
LLM_TOP_P=1.0

# Reasoning effort: low, medium or high
LLM_REASONING_EFFORT=medium
LLM_REASONING_EFFORT_PRD=medium
LLM_REASONING_EFFORT_CASES=low
LLM_REASONING_EFFORT_SCRIPTS=medium
LLM_REASONING_EFFORT_ANALYZER=high

# Maximum model requests in flight at once
LLM_CONCURRENCY=4

# Context window of the served model, in tokens
LLM_CONTEXT_TOKENS=131072

# Per-request timeout in milliseconds; long, because the first request after idle waits for the model to load
LLM_TIMEOUT_MS=1200000

# Hard limits per run: no further model calls once either is reached
LLM_MAX_TOKENS_PER_RUN=5000000
LLM_MAX_COST_USD_PER_RUN=2.00

# Optional per-module model overrides
LLM_MODEL_PRD=
LLM_MODEL_CASES=
LLM_MODEL_SCRIPTS=
LLM_MODEL_ANALYZER=
