# Copy to .env and fill in. Never commit .env.

# Model provider: openai-compatible (OpenRouter, self-hosted vLLM, OpenAI) or anthropic
LLM_PROVIDER=openai-compatible

# Endpoint address (ending in /v1) and the model name the server exposes
LLM_BASE_URL=
LLM_MODEL=z-ai/glm-5.3-flash

# API key, if the endpoint requires one
LLM_API_KEY=

# Extra HTTP headers as JSON, if the endpoint requires them (e.g. proxy authentication)
LLM_EXTRA_HEADERS=

# Extra fields merged into every request body, as a JSON object (e.g. provider routing)
LLM_EXTRA_BODY=

# How reasoning effort is sent: reasoning_effort (top-level field) or reasoning_object (reasoning: {effort})
LLM_REASONING_PARAM=reasoning_effort

# Example: OpenRouter, pinned to one provider (put your own key in LLM_API_KEY)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=z-ai/glm-5.3-flash
# LLM_API_KEY=sk-or-...
# LLM_EXTRA_BODY={"provider":{"only":["wafer/nvfp4"],"allow_fallbacks":false}}

# Sampling
LLM_TEMPERATURE=1.0
LLM_TOP_P=1.0

# Reasoning effort: low, medium or high
LLM_REASONING_EFFORT=medium
LLM_REASONING_EFFORT_PRD=medium
LLM_REASONING_EFFORT_CASES=low
LLM_REASONING_EFFORT_SCRIPTS=medium
LLM_REASONING_EFFORT_ANALYZER=medium

# Maximum model requests in flight at once
LLM_CONCURRENCY=4

# Context window of the served model, in tokens
LLM_CONTEXT_TOKENS=131072

# Per-request timeout in milliseconds; long, because the first request after idle waits for the model to load
LLM_TIMEOUT_MS=1200000

# Hard limits per run: no further model calls once either is reached.
# Cost uses the provider-reported cost when the response has one, otherwise config/pricing.json.
LLM_MAX_TOKENS_PER_RUN=20000000
LLM_MAX_COST_USD_PER_RUN=2.00

# Optional per-module model overrides
LLM_MODEL_PRD=
LLM_MODEL_CASES=
LLM_MODEL_SCRIPTS=
LLM_MODEL_ANALYZER=
