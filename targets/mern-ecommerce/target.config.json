{
  "schemaVersion": "1.0",
  "name": "mern-ecommerce",
  "repoPath": "targets/mern-ecommerce/repo",
  "repoUrl": "https://github.com/mohamedsamara/mern-ecommerce",
  "goldenRef": "golden",
  "backend": {
    "cwd": "server",
    "install": "npm ci",
    "start": "npm start",
    "baseUrl": "http://localhost:3000",
    "apiPrefix": "/api",
    "healthCheckUrl": "http://localhost:3000/api/category/list",
    "env": {
      "PORT": "3000",
      "MONGO_URI": "mongodb://mongo:27017/mern_ecommerce_test",
      "JWT_SECRET": "test-secret",
      "CLIENT_URL": "http://localhost:8080",
      "BASE_API_URL": "api"
    },
    "disabledServices": {
      "MAILCHIMP_KEY": "",
      "MAILCHIMP_LIST_KEY": "",
      "MAILGUN_KEY": "",
      "MAILGUN_DOMAIN": "",
      "MAILGUN_EMAIL_SENDER": "",
      "GOOGLE_CLIENT_ID": "",
      "GOOGLE_CLIENT_SECRET": "",
      "FACEBOOK_CLIENT_ID": "",
      "FACEBOOK_CLIENT_SECRET": "",
      "AWS_ACCESS_KEY_ID": "",
      "AWS_SECRET_ACCESS_KEY": "",
      "AWS_BUCKET_NAME": "",
      "AWS_EC2_METADATA_DISABLED": "true"
    }
  },
  "frontend": {
    "cwd": "client",
    "install": "npm ci",
    "start": "npm run dev -- --host 127.0.0.1",
    "baseUrl": "http://localhost:8080",
    "healthCheckUrl": "http://localhost:8080",
    "env": {
      "API_URL": "http://localhost:3000/api"
    },
    "envFile": ".env",
    "sourceRoots": ["client/app"]
  },
  "lifecycle": {
    "reset": "mongosh \"mongodb://mongo:27017/mern_ecommerce_test\" --quiet --eval \"db.dropDatabase()\"",
    "resetCwd": ".",
    "seedCommand": "node --require \"{{targetDir}}/seed-deterministic.cjs\" utils/seed.js admin@example.com admin123",
    "seedCwd": "server",
    "startupTimeoutMs": 180000
  },
  "fixtures": {
    "users": {
      "admin": { "email": "admin@example.com", "password": "admin123", "role": "admin" },
      "alice": {
        "email": "alice@example.test",
        "password": "Passw0rd!alice",
        "firstName": "Alice",
        "lastName": "Test",
        "role": "member"
      },
      "bob": {
        "email": "bob@example.test",
        "password": "Passw0rd!bob",
        "firstName": "Bob",
        "lastName": "Test",
        "role": "member"
      }
    }
  },
  "seed": [
    {
      "method": "POST",
      "path": "/api/auth/register",
      "body": {
        "email": "{{fixtures.users.alice.email}}",
        "firstName": "{{fixtures.users.alice.firstName}}",
        "lastName": "{{fixtures.users.alice.lastName}}",
        "password": "{{fixtures.users.alice.password}}",
        "isSubscribed": false
      }
    },
    {
      "method": "POST",
      "path": "/api/auth/register",
      "body": {
        "email": "{{fixtures.users.bob.email}}",
        "firstName": "{{fixtures.users.bob.firstName}}",
        "lastName": "{{fixtures.users.bob.lastName}}",
        "password": "{{fixtures.users.bob.password}}",
        "isSubscribed": false
      }
    }
  ],
  "seedCheck": {
    "method": "GET",
    "path": "/api/product/list?sortOrder=%7B%22_id%22%3A-1%7D&min=1&max=2500&rating=0&page=1&limit=10",
    "expect": { "status": 200, "nonEmptyArrayAt": "products" }
  },
  "auth": {
    "login": {
      "method": "POST",
      "path": "/api/auth/login",
      "body": { "email": "{{user.email}}", "password": "{{user.password}}" }
    },
    "tokenAt": "token",
    "header": "Authorization",
    "prefix": "",
    "storage": { "kind": "localStorage", "key": "token" },
    "uiLogin": {
      "path": "/login",
      "fields": {
        "email": { "placeholder": "Please Enter Your Email" },
        "password": { "placeholder": "Please Enter Your Password" }
      },
      "submit": { "role": "button", "name": "Login" },
      "waitFor": { "urlNot": "/login" }
    }
  },
  "facts": [
    {
      "name": "productList",
      "method": "GET",
      "path": "/api/product/list?sortOrder=%7B%22_id%22%3A-1%7D&min=1&max=2500&rating=0&page=1&limit=10",
      "keep": ["products[].name", "products[].slug", "products[].price", "products[].quantity", "products[].brand.name", "count", "totalPages", "currentPage"]
    },
    {
      "name": "productItem",
      "method": "GET",
      "path": "/api/product/item/{{facts.productList.body.products.0.slug}}",
      "keep": ["product.name", "product.slug", "product.sku", "product.price", "product.quantity", "product.taxable", "product.brand.name", "product.brand.slug"]
    },
    { "name": "productSearch", "method": "GET", "path": "/api/product/list/search/{{facts.productList.body.products.0.name}}" },
    { "name": "productNotFound", "method": "GET", "path": "/api/product/item/no-such-product" },
    { "name": "categoryList", "method": "GET", "path": "/api/category/list", "keep": ["categories[].name", "categories[].slug", "categories[].isActive"] },
    { "name": "brandList", "method": "GET", "path": "/api/brand/list", "keep": ["brands[].name", "brands[].slug", "brands[].isActive"] },
    { "name": "productsAsAdmin", "method": "GET", "path": "/api/product", "as": "users.admin", "keep": ["products[].name", "products[].slug"], "maxItems": 3 },
    { "name": "meAsAlice", "method": "GET", "path": "/api/user/me", "as": "users.alice", "keep": ["user.email", "user.firstName", "user.lastName", "user.role", "user.provider"] },
    { "name": "meNoToken", "method": "GET", "path": "/api/user/me" },
    { "name": "merchantsNoToken", "method": "GET", "path": "/api/merchant" },
    { "name": "merchantsAsMember", "method": "GET", "path": "/api/merchant", "as": "users.alice" },
    { "name": "productsAsMember", "method": "GET", "path": "/api/product", "as": "users.alice" },
    {
      "name": "loginWrongPassword",
      "method": "POST",
      "path": "/api/auth/login",
      "body": { "email": "{{fixtures.users.alice.email}}", "password": "not-the-password" }
    },
    { "name": "ordersAsAlice", "method": "GET", "path": "/api/order/me", "as": "users.alice" },
    { "name": "wishlistAsAlice", "method": "GET", "path": "/api/wishlist", "as": "users.alice" },
    { "name": "addressesAsAlice", "method": "GET", "path": "/api/address", "as": "users.alice" }
  ],
  "sourceHints": {
    "include": ["README.md", "server/**", "client/app/**"],
    "exclude": ["**/node_modules/**", "**/*.test.*", "**/dist/**", "**/build/**"]
  },
  "forbiddenPaths": []
}
